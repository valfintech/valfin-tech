    {
      "id": "921e7bf5-529f-488a-9bdc-b44671ed92fd",
      "name": "Compute Next Slot",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const s = $('Settings Loader').first().json;\nconst CONFIG = {\n  DEFAULT_TIMEZONE: s.timezone,\n  BUSINESS_START_HOUR: s.business_start_hour,\n  BUSINESS_END_HOUR: s.business_end_hour,\n  SLOT_MINUTES: s.appointment_slot_minutes,\n  MIN_LEAD_HOURS: s.new_booking_min_lead_hours,\n  WORKING_DAYS: (s.working_days || []).map(Number)\n};\n\nconst input = $('Input').first().json;\nconst appts = $input.all().map(i => i.json);\n\nfunction formatTime(t) {\n  const str = String(t || '').trim();\n  if (/AM|PM/i.test(str)) return str;\n  const m = str.match(/^(\\d{1,2}):(\\d{2})/);\n  if (m) {\n    let h = parseInt(m[1], 10);\n    const min = m[2];\n    const period = h >= 12 ? 'PM' : 'AM';\n    if (h === 0) h = 12;\n    else if (h > 12) h -= 12;\n    return h + ':' + min + ' ' + period;\n  }\n  return str;\n}\nconst taken = new Set();\nfor (const a of appts) {\n  if (String(a['Status'] || '').trim() !== 'Scheduled') continue;\n  const d = String(a['Appt Date'] || '').trim();\n  const t = formatTime(String(a['Appt Time'] || '').trim()).toUpperCase();\n  if (d && t) taken.add(d + '|' + t);\n}\n\nconst now = DateTime.now().setZone(CONFIG.DEFAULT_TIMEZONE);\nlet cursor = now.plus({ hours: CONFIG.MIN_LEAD_HOURS }).set({ second: 0, millisecond: 0 });\nconst rem = cursor.minute % CONFIG.SLOT_MINUTES;\nif (rem !== 0) cursor = cursor.plus({ minutes: CONFIG.SLOT_MINUTES - rem });\n\nlet found = null;\nlet safety = 0;\nwhile (!found && safety < 3000) {\n  safety++;\n  if (!CONFIG.WORKING_DAYS.includes(cursor.weekday)) {\n    cursor = cursor.plus({ days: 1 }).set({ hour: CONFIG.BUSINESS_START_HOUR, minute: 0, second: 0, millisecond: 0 });\n    continue;\n  }\n  if (cursor.hour < CONFIG.BUSINESS_START_HOUR) {\n    cursor = cursor.set({ hour: CONFIG.BUSINESS_START_HOUR, minute: 0, second: 0, millisecond: 0 });\n    continue;\n  }\n  if (cursor.hour >= CONFIG.BUSINESS_END_HOUR) {\n    cursor = cursor.plus({ days: 1 }).set({ hour: CONFIG.BUSINESS_START_HOUR, minute: 0, second: 0, millisecond: 0 });\n    continue;\n  }\n  const dateStr = cursor.toFormat('yyyy-MM-dd');\n  const timeStr = cursor.toFormat('h:mm a').toUpperCase();\n  const key = dateStr + '|' + timeStr;\n  if (!taken.has(key)) {\n    found = { date: dateStr, time: timeStr };\n  } else {\n    cursor = cursor.plus({ minutes: CONFIG.SLOT_MINUTES });\n  }\n}\n\nif (!found) {\n  return [{ json: { ...input, schedulingFailed: true } }];\n}\n\nconst apptId = 'APT-' + input.leadId;\nconst customerName = [input.firstName, input.lastName].filter(Boolean).join(' ');\nreturn [{ json: { ...input, apptId, customerName, confirmedDate: found.date, confirmedTime: found.time, schedulingFailed: false } }];"
      }
    },
