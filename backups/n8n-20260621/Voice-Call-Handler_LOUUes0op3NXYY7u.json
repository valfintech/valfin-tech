atus }}","operator":{"type":"string","operation":"exists","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"32a6000f-2c16-4ea3-aa56-ddbe9801ac15","name":"Owner Answered?","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[672,96],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $('Voice Webhook').first().json.body.DialCallStatus }}","operator":{"type":"string","operation":"equals"},"rightValue":"completed"}],"combinator":"and"},"options":{}}},{"id":"ea9af77c-e1e2-44e6-836c-bceff3a84118","name":"Respond Empty (End Call)","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[896,0],"parameters":{"respondWith":"text","responseBody":"<?xml version=\"1.0\" encoding=\"UTF-8\"?><Response></Response>","options":{"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/xml"}]}}}},{"id":"562ee4f4-753c-48d5-abe2-6771cf5e0e44","name":"Trigger Missed-Call SMS","type":"n8n-nodes-base.httpRequest","typeVersion":4.4,"position":[896,192],"parameters":{"method":"POST","url":"https://valfin.app.n8n.cloud/webhook/twilio-call-status","sendBody":true,"contentType":"json","specifyBody":"json","jsonBody":"={{ { CallStatus: $('Voice Webhook').first().json.body.DialCallStatus, From: $('Voice Webhook').first().json.body.From, To: $('Voice Webhook').first().json.body.To, CallSid: $('Voice Webhook').first().json.body.CallSid } }}","options":{}}},{"id":"5dad3f53-291e-4901-939e-88f7a6266946","name":"Respond Empty After SMS","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[1120,192],"parameters":{"respondWith":"text","responseBody":"<?xml version=\"1.0\" encoding=\"UTF-8\"?><Response></Response>","options":{"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/xml"}]}}}},{"id":"9ee6d860-7fc8-4192-87b8-147105bc524a","name":"Build Dial TwiML","type":"n8n-nodes-base.code","typeVersion":2,"position":[672,384],"parameters":{"mode":"runOnceForAllItems","language":"javaScript","jsCode":"\nconst s = $('Settings Loader').first().json;\nconst ownerPhone = s.owner_phone_e164;\nconst timeoutSeconds = s.call_forward_timeout_seconds || 20;\nconst actionUrl = 'https://valfin.app.n8n.cloud/webhook/voice-incoming';\nconst escapeXml = (v) => String(v).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst xml = '<?xml version=\"1.0\" encoding=\"UTF-8\"?><Response><Dial timeout=\"' + timeoutSeconds + '\" action=\"' + escapeXml(actionUrl) + '\" answerOnBridge=\"true\"><Number>' + escapeXml(ownerPhone) + '</Number></Dial></Response>';\nreturn [{ json: { xml } }];"}},{"id":"c4a530ee-32f5-4e4c-b6ac-e1431a203607","name":"Respond With Dial TwiML","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[896,384],"parameters":{"respondWith":"text","responseBody":"={{ $json.xml }}","options":{"responseHeaders":{"entries":[{"name":"Content-Type","value":"text/xml"}]}}}}],"tags":[],"description":"Production phone flow: forwards incoming calls to the owner's phone via Twilio Dial verb; on no-answer/busy/failed, triggers the Missed-Call Auto-SMS workflow instead of playing Twilio's default message."}
